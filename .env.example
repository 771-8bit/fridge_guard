# Fridge Guard - Local Environment Example (NO REAL SECRETS)
# Copy to a secure external location when configuring the device or release tools.
# Never commit real credentials to Git!

# --- Target Device Provisioning Placeholders ---
# Wi-Fi network SSID (2.4 GHz)
WIFI_SSID="MyHomeNetwork"
# Wi-Fi network WPA2/WPA3 password
WIFI_PASSWORD="SamplePassword123"

# LINE Messaging API Channel Access Token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN="SAMPLE_LONG_LIVED_CHANNEL_ACCESS_TOKEN_DO_NOT_COMMIT"

# Destination LINE User ID (starts with 'U', 33 characters)
LINE_DESTINATION_USER_ID="U0123456789abcdef0123456789abcdef"

# Daily report time in JST (24h format HH:MM)
DAILY_REPORT_TIME="20:00"

# Inactivity threshold in hours
INACTIVITY_THRESHOLD_HOURS=24

# Door-open-too-long threshold in minutes
OPEN_TOO_LONG_MINUTES=30

# Monthly outgoing LINE message safety quota
MONTHLY_MESSAGE_LIMIT=120

# Maintenance button actions (options: line_test, status_now, ota_check, none)
BUTTON_SHORT_PRESS_ACTION="line_test"
BUTTON_LONG_PRESS_ACTION="ota_check"

# OTA Manifest URL
OTA_MANIFEST_URL="https://raw.githubusercontent.com/771-8bit/fridge_guard/main/release/manifest.json"

# --- Release / Setup Helper Placeholders (Host Only) ---
# Path to OTA private signing key (outside repo!)
OTA_SIGNING_PRIVATE_KEY="/path/to/ota_signing_private.pem"

# LINE Channel Secret (used strictly for temporary setup webhook signature verification)
LINE_CHANNEL_SECRET="SAMPLE_CHANNEL_SECRET_DO_NOT_COMMIT"
